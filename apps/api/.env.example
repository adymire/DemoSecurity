# ---- DemoSecurity API env ----
# Copy: cp .env.example .env  (never commit .env)
DB_DRIVER=mongodb
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000

# 32+ char random strings, DIFFERENT values
SESSION_SECRET=replace-with-at-least-32-random-characters-01
RISK_SIGNAL_PEPPER=replace-with-a-separate-random-secret-02
JWT_SECRET=replace-with-a-third-random-secret-03
JWT_EXPIRES_IN=15m

# MongoDB (MERN / default)
MONGODB_URI=mongodb://localhost:27017/demosecurity

# SQLite (desktop / local dev, no docker service needed)
SQLITE_DATABASE_URL=file:./data/demosecurity.db

# PostgreSQL (relational / production)
DATABASE_URL=postgresql://demosecurity:demosecurity@localhost:5432/demosecurity

# Redis (optional, rate-limit + queues). Leave empty to run without redis.
REDIS_URL=redis://localhost:6379

# OAuth — create per-environment apps, exact callback URLs only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Billing webhooks — backend trusts ONLY signed webhooks
PAYMENT_PROVIDER=stripe
PAYMENT_WEBHOOK_SECRET=
BILLING_RETURN_DEEPLINK=demosecurity://billing/complete
FREE_PLAN_PROMPT_LIMIT=50
PRO_PLAN_PROMPT_LIMIT=2000

# Fake-user security adapters — stub until set (app boots without them)
# Daily disposable-domain list sync URL (open-source list mirror)
FAKESEC_DISPOSABLE_LIST_URL=
# IP intel: maxmind | ipqs | abuseipdb (needs API key to go live)
FAKESEC_IP_INTEL_PROVIDER=
FAKESEC_IP_INTEL_API_KEY=
