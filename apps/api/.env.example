DB_DRIVER=mongodb
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_APP_URL=http://localhost:3000

# MongoDB (MERN/default)
MONGODB_URI=mongodb://localhost:27017/demosecurity

# SQLite (desktop/local)
SQLITE_DATABASE_URL=file:./data/demosecurity.db

# PostgreSQL (relational/production option)
DATABASE_URL=postgresql://demosecurity:demosecurity@localhost:5432/demosecurity

# OAuth: create apps with providers; never commit real values
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

PAYMENT_WEBHOOK_SECRET=
RISK_SIGNAL_PEPPER=replace-with-a-separate-random-secret
